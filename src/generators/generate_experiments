def generate_experiments(seed):

    status = random.choice(["draft", "running", "completed"])
    now = datetime.now(timezone.utc)

    if status == "draft":
        start_at = now + timedelta(days =7)
        end_at = None

    if status == "running":
        start_at = now + timedelta(days =14)
        end_at = None

    else:
        end_at = now - timedelta(days=1)
        start_at = end_at - timedelta(days=30)


    return { 

        "experiment_id": seed["experiment_id"],
        "experiment_name": seed["experiment_name"],
        "status": status,
        "start_at": start_at,
        "end_at": end_at,
        "variants": random.choice(variants),
        "primary_metric": seed["primary_metric"],
        "target_population": "all_users"

        }

experiments = [
    generate_expirements(seed)
    for seed in experiments]
    